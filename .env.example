# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.
# -----------------------------------------------------------------------------

# Public URL of the app (used for auth redirects and Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: bypasses RLS. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter (https://openrouter.ai/keys) ---------------------------------
OPENROUTER_API_KEY=
# Optional override
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set to 1 to use a built-in mock model (no OpenRouter calls) for local demos/tests
MOCK_AI=0

# --- Stripe (Developers → API keys / Webhooks) -------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID of the recurring monthly Pro price (MYR)
STRIPE_PRICE_PRO_MONTHLY=price_...

# --- Upstash Redis (rate limiting + capacity counters) -----------------------
# Without these, an in-memory store is used (dev only; not shared across instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin alerts (spending cap 80% / 100%) via Resend -----------------------
# Without RESEND_API_KEY, alerts are written to the server log.
RESEND_API_KEY=
ALERT_EMAIL_FROM="Vectors <alerts@yourdomain.com>"
# Comma-separated
ADMIN_ALERT_EMAIL=you@example.com

# --- Vercel Cron -------------------------------------------------------------
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes.
CRON_SECRET=

# --- Seed script only --------------------------------------------------------
DEMO_ADMIN_EMAIL=admin@example.com
# Leave empty to generate a random password (printed once by `npm run seed`)
DEMO_ADMIN_PASSWORD=
